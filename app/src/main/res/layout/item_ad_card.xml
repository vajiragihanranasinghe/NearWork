<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NearWork.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/sp_md"
    android:layout_marginVertical="@dimen/sp_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image -->
        <ImageView
            android:id="@+id/adImagePreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_surface_variant"
            android:visibility="gone"/>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- Badges row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/adTradeType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 Sell"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"/>

                <TextView
                    android:id="@+id/adFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="@dimen/sp_xs"
                    android:paddingVertical="2dp"
                    android:text="@string/badge_featured"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/sp_xxs"/>

                <TextView
                    android:id="@+id/adVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/success"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/sp_xxs"/>

                <ImageButton
                    android:id="@+id/adOverflowButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_more"
                    android:contentDescription="More"
                    android:scaleType="centerInside"
                    app:tint="@color/text_tertiary"/>

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/adTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ad title"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/sp_xxs"/>

            <!-- Category + views -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/sp_xxs">

                <TextView
                    android:id="@+id/adCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Category"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/adViews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 views"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_tertiary"/>

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/adDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/sp_xs"/>

            <!-- Exchange info -->
            <TextView
                android:id="@+id/adExchange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wants: …"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/warning"
                android:visibility="gone"
                android:layout_marginTop="@dimen/sp_xxs"/>

            <!-- Price + Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/sp_xs">

                <TextView
                    android:id="@+id/adPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Price"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"/>

                <TextView
                    android:id="@+id/adLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:drawablePadding="@dimen/sp_xxs"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_thin"
                android:background="@color/border_subtle"
                android:layout_marginVertical="@dimen/sp_sm"/>

            <!-- Actions row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/contactButton"
                    style="@style/Widget.NearWork.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_contact"
                    android:textSize="13sp"
                    android:layout_marginEnd="@dimen/sp_xxs"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.NearWork.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_share"
                    android:textSize="13sp"
                    android:layout_marginStart="@dimen/sp_xxs"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
